  "components": [
    {
      "name": "Primary Button (bilingual)",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "The one main action on a screen; carries its English subtitle when the label is in another language.",
      "html": "<button class=\"ds-btn ds-btn-primary\"><span lang=\"hi\">हाँ, भेजें</span><span class=\"ds-sub\" lang=\"en\">Yes, send</span></button>",
      "css": ".ds-btn{font:600 1.125rem/1 'Noto Sans',system-ui,sans-serif;border:0;border-radius:9999px;cursor:pointer;transition:opacity .2s cubic-bezier(.2,.7,.2,1),background .2s}.ds-btn:focus-visible{outline:3px solid var(--v-focus,#0b5cd6);outline-offset:3px}.ds-sub{display:block;margin-top:2px;font-size:.875rem;font-weight:400;opacity:.85}.ds-btn-primary{background:var(--v-brand,#0b5cd6);color:#fff;min-height:56px;padding:12px 28px;box-shadow:0 1px 2px rgb(0 28 100 / .05)}.ds-btn-primary:hover{opacity:.9}"
    },
    {
      "name": "Navy Button",
      "kind": "button",
      "refersTo": "button-navy",
      "description": "Secondary action beside a form, such as Check.",
      "html": "<button class=\"ds-btn ds-btn-navy\">Check</button>",
      "css": ".ds-btn{font:600 1.125rem/1 'Noto Sans',system-ui,sans-serif;border:0;border-radius:9999px;cursor:pointer;transition:opacity .2s cubic-bezier(.2,.7,.2,1),background .2s}.ds-btn:focus-visible{outline:3px solid var(--v-focus,#0b5cd6);outline-offset:3px}.ds-sub{display:block;margin-top:2px;font-size:.875rem;font-weight:400;opacity:.85}.ds-btn-navy{background:var(--v-navy,#071a4d);color:#fff;min-height:48px;padding:12px 24px}.ds-btn-navy:hover{background:var(--v-navy-2,#12307a)}"
    },
    {
      "name": "Quiet Button",
      "kind": "button",
      "refersTo": "button-quiet",
      "description": "Alternatives such as Edit or Pay someone instead.",
      "html": "<button class=\"ds-btn ds-btn-quiet\">Edit</button>",
      "css": ".ds-btn{font:600 1.125rem/1 'Noto Sans',system-ui,sans-serif;border:0;border-radius:9999px;cursor:pointer;transition:opacity .2s cubic-bezier(.2,.7,.2,1),background .2s}.ds-btn:focus-visible{outline:3px solid var(--v-focus,#0b5cd6);outline-offset:3px}.ds-sub{display:block;margin-top:2px;font-size:.875rem;font-weight:400;opacity:.85}.ds-btn-quiet{background:transparent;color:var(--v-brand,#0b5cd6);min-height:48px;padding:12px 24px}.ds-btn-quiet:hover{background:var(--v-brand-soft,#e7f0fc)}"
    },
    {
      "name": "Danger Button",
      "kind": "button",
      "refersTo": "button-danger",
      "description": "Cancel a payment during its hold.",
      "html": "<button class=\"ds-btn ds-btn-danger\">Cancel this payment</button>",
      "css": ".ds-btn{font:600 1.125rem/1 'Noto Sans',system-ui,sans-serif;border:0;border-radius:9999px;cursor:pointer;transition:opacity .2s cubic-bezier(.2,.7,.2,1),background .2s}.ds-btn:focus-visible{outline:3px solid var(--v-focus,#0b5cd6);outline-offset:3px}.ds-sub{display:block;margin-top:2px;font-size:.875rem;font-weight:400;opacity:.85}.ds-btn-danger{background:var(--v-terracotta,#c4261d);color:#fff;min-height:64px;padding:12px 32px;width:100%}.ds-btn-danger:hover{opacity:.9}"
    },
    {
      "name": "Field",
      "kind": "input",
      "refersTo": "input",
      "description": "Phone and amount fields: large tabular text, blue outline on focus.",
      "html": "<label class=\"ds-field\">Phone number<input class=\"ds-input\" placeholder=\"+1 (408) 555-0139\" inputmode=\"tel\"></label>",
      "css": ".ds-field{display:grid;gap:4px;font:400 .875rem/1.4 'Noto Sans',system-ui,sans-serif;color:var(--v-ink-3,#4d6189)}.ds-input{min-height:48px;padding:0 16px;border:2px solid var(--v-line,#dce6f5);border-radius:12px;background:#fff;color:var(--v-ink,#071a4d);font-size:1.125rem;font-variant-numeric:tabular-nums;outline:none;caret-color:var(--v-brand,#0b5cd6)}.ds-input::placeholder{color:var(--v-placeholder,#5f7096)}.ds-input:focus{border-color:var(--v-brand,#0b5cd6)}"
    },
    {
      "name": "Navigation Bar",
      "kind": "nav",
      "refersTo": "nav-bar",
      "description": "Navy account bar with Signal Blue active underline.",
      "html": "<nav class=\"ds-nav\"><span class=\"ds-logo\">Verbo</span><a class=\"ds-nav-a\" href=\"#\">Home</a><a class=\"ds-nav-a ds-on\" href=\"#\" aria-current=\"page\">Send</a><a class=\"ds-nav-a\" href=\"#\">Examples</a><span class=\"ds-pill\">Sandbox</span></nav>",
      "css": ".ds-nav{display:flex;align-items:center;gap:8px;background:var(--v-navy,#071a4d);color:#fff;padding:0 16px;font:500 1rem/1 'Noto Sans',system-ui,sans-serif}.ds-logo{font-weight:600;font-size:1.25rem;margin-right:16px}.ds-nav-a{color:rgb(255 255 255 / .75);text-decoration:none;padding:22px 12px 19px;border-bottom:3px solid transparent}.ds-nav-a:hover{color:#fff}.ds-nav-a.ds-on{color:#fff;border-bottom-color:var(--v-signal,#8fd3ff)}.ds-nav-a:focus-visible{outline:3px solid var(--v-signal,#8fd3ff)}.ds-pill{margin-left:auto;background:var(--v-navy-2,#12307a);border-radius:9999px;padding:4px 12px;font-size:.75rem}"
    },
    {
      "name": "Attention Notice (bilingual)",
      "kind": "card",
      "refersTo": "notice-attention",
      "description": "Look again: message in the reader's language with English below.",
      "html": "<div class=\"ds-notice\" role=\"note\"><span class=\"ds-dot\">!</span><div><p lang=\"es\">Este número tiene un dígito distinto al de un contacto.</p><span class=\"ds-sub2\" lang=\"en\">This number is one digit away from a contact's number.</span></div></div>",
      "css": ".ds-notice{display:flex;gap:12px;padding:16px;border-radius:12px;background:var(--v-marigold-soft,#fff4e0);color:var(--v-marigold-ink,#6b3a00);font:500 1rem/1.5 'Noto Sans',system-ui,sans-serif}.ds-notice p{margin:0}.ds-dot{display:grid;place-items:center;flex:none;width:24px;height:24px;border-radius:50%;background:#fff;font-weight:600;font-size:.875rem}.ds-sub2{display:block;margin-top:2px;font-size:.875rem;font-weight:400;opacity:.85}"
    },
