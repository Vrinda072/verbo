    },
    {
      "name": "Read-back Stage",
      "kind": "custom",
      "refersTo": "readback-stage",
      "description": "Signature: one payment stated in a language, the amount highlighted, English beneath, checked facts below.",
      "html": "<div class=\"ds-stage\"><p class=\"ds-k\">Read back to you in Hindi</p><p class=\"ds-rb\" lang=\"hi\">Manuel Lopes को <bdi dir=\"ltr\" class=\"ds-amt\">$40.00</bdi> भेजें?</p><p class=\"ds-en\" lang=\"en\">Send $40.00 to Manuel Lopes?</p><dl class=\"ds-facts\"><div><dt>Amount checked</dt><dd>40.00 US dollars</dd></div><div><dt>Recipient</dt><dd>Manuel Lope<span class=\"ds-mk\">s</span></dd></div></dl></div>",
      "css": ".ds-stage{background:var(--v-navy,#071a4d);color:#fff;border-radius:28px;padding:36px;font-family:'Noto Sans',system-ui,sans-serif}.ds-k{margin:0;opacity:.75}.ds-rb{margin:16px 0 0;font:600 2rem/1.3 'Noto Sans Display','Noto Sans Devanagari',system-ui,sans-serif}.ds-amt{background:var(--v-signal,#8fd3ff);color:var(--v-navy,#071a4d);border-radius:10px;padding:0 10px}.ds-en{margin:4px 0 0;font-size:1.125rem;opacity:.85}.ds-facts{display:flex;gap:32px;margin:24px 0 0;padding-top:20px;border-top:1px solid var(--v-navy-2,#12307a)}.ds-facts dt{font-size:.875rem;opacity:.75}.ds-facts dd{margin:0;font-size:1.25rem;font-weight:600}.ds-mk{color:var(--v-mark-on-dark,#f2a93b)}"
    },
    {
      "name": "Digit Diff",
      "kind": "custom",
