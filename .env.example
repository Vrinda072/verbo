APP_NAME=Verbo
NEXT_PUBLIC_APP_NAME=Verbo
APP_BASE_URL=http://localhost:3000
# 1 = fake PayPal/speech/LLM clients, 0 = real
MOCK=1

# PayPal sandbox (REST app linked to the Verbo Platform business account)
PAYPAL_ENV=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=

# Sandbox personal accounts (emails only; used by scripts and docs)
# Sreenivas Rao (sender, Telugu)
SANDBOX_SENDER_EMAIL=
# Manuel Lopez (intended recipient, Spanish)
SANDBOX_INTENDED_RECIPIENT_EMAIL=
# Manuel Lopes (wrong recipient, Portuguese)
SANDBOX_WRONG_RECIPIENT_EMAIL=

# Speech / translation
SONIOX_API_KEY=

# LLM
# gemini (free key from Google AI Studio), anthropic, or rules (offline parser). Works with MOCK=1 or 0.
LLM_PROVIDER=gemini
GEMINI_API_KEY=
# Optional. Default gemini-3.6-flash.
GEMINI_MODEL=
ANTHROPIC_API_KEY=

# AG Grid / AG Studio
AG_GRID_LICENSE_KEY=

# Database (empty = embedded PGlite in ./.pglite for local dev)
DATABASE_URL=

# Generated locally, never shared
TOKEN_SIGNING_SECRET=

# Free by default. browser = built-in speech recognition (Chrome, Edge, Safari); soniox = needs paid Soniox credit.
SPEECH_PROVIDER=browser
# Empty = follows the AI provider, with MyMemory (free, 5,000 chars/day) as the fallback. none = no translation.
TRANSLATION_PROVIDER=
